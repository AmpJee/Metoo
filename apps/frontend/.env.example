# ---------------------------------------------------------------------------
# Frontend environment
# Copy to `.env` (`make env` does this for you).
# ---------------------------------------------------------------------------

# Port the Next.js server listens on.
# Leave unset on Railway — it injects its own PORT.
PORT=5173

NODE_ENV=development

# Where this server reaches the API.
#
# Deliberately NOT a NEXT_PUBLIC_ variable. The browser never calls Elysia
# directly: it calls this Next server, which holds the session cookies and
# forwards the request with a Bearer token. Exposing the API origin to the
# client would invite bypassing that.
#
# Local:   http://localhost:3000
# Docker:  http://backend:3000        (service name — server-to-server)
# Railway: https://${{backend.RAILWAY_PRIVATE_DOMAIN}}
API_URL="http://localhost:3000"
