# ---------------------------------------------------------------------------
# Frontend environment
# Copy to `.env` (`make env` does this for you).
# ---------------------------------------------------------------------------

# Port the static server listens on.
# Leave unset on Railway — it injects its own PORT.
PORT=5173

NODE_ENV=development

# Where the browser should send API calls.
#
# This must be an address the BROWSER can reach, not a Docker service name:
# the fetch runs on the user's machine, not inside the container. That is why
# it stays http://localhost:3000 even under docker compose.
#
# Railway: https://${{backend.RAILWAY_PUBLIC_DOMAIN}}
PUBLIC_API_URL="http://localhost:3000"
