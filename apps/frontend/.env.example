# ---------------------------------------------------------------------------
# Frontend environment
# Copy to `.env` (`make env` does this for you).
# ---------------------------------------------------------------------------

# Port the Next.js server listens on.
# Leave unset on Railway — it injects its own PORT.
PORT=5173

NODE_ENV=development

# Where this server reaches the API.
#
# Deliberately NOT a NEXT_PUBLIC_ variable. The browser never calls Elysia
# directly: it calls this Next server, which holds the session cookies and
# forwards the request with a Bearer token. Exposing the API origin to the
# client would invite bypassing that.
#
# Local:   http://localhost:3000
# Docker:  http://backend:3000        (service name — server-to-server)
# Railway: https://${{backend.RAILWAY_PRIVATE_DOMAIN}}
API_URL="http://localhost:3000"

# Public origin of this site, used for link-preview (Open Graph) tags.
#
# They have to be absolute — a chat app fetching the page has no base to
# resolve against — so leaving this wrong makes shared links point at
# localhost. Railway injects RAILWAY_PUBLIC_DOMAIN and it is picked up
# automatically; set this only for a custom domain.
SITE_URL=""

# --- PromptPay -------------------------------------------------------------
# Public URL of the platform's PromptPay QR image in Supabase Storage.
#
# Upload the QR to the PUBLIC bucket (the same one product photos use), then
# copy its public URL from the Supabase dashboard:
#   Storage > product-photos > <your file> > Get URL
#
# The full URL rather than a bucket and key, so this app needs no Supabase
# credentials — those stay in the API. Leave it blank and the pay screen says
# the QR is not set up yet instead of showing a broken image.
PROMPTPAY_QR_URL=""
