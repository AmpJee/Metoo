# ---------------------------------------------------------------------------
# Backend environment
# Copy to `.env` (`make env` does this for you) and fill in real values.
# Never commit `.env` — it is gitignored.
# ---------------------------------------------------------------------------

# --- Supabase Postgres -----------------------------------------------------
# Supabase gives you TWO connection strings and they are NOT interchangeable.
# Find both under: Supabase dashboard > Project Settings > Database > Connection string
#
#   DATABASE_URL  Transaction pooler, port 6543. Used by the running app.
#                 Pooled connections are what a serverless/containerised app
#                 should hold.
#
#   DIRECT_URL    Direct / session connection, port 5432. Used by the Prisma
#                 CLI only (migrate, studio). Migrations create prepared
#                 statements and advisory locks, which the transaction pooler
#                 does not support — running them through 6543 will fail.
#
# Getting these two swapped is the single most common setup mistake here.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# --- Server ----------------------------------------------------------------
# Port the API listens on. Leave unset on Railway — it injects its own PORT.
PORT=3000

NODE_ENV=development

# Browser origin allowed to call this API.
# Local:   http://localhost:5173
# Railway: https://${{frontend.RAILWAY_PUBLIC_DOMAIN}}
CORS_ORIGIN="http://localhost:5173"

# --- Auth ------------------------------------------------------------------
# Two separate secrets, each at least 32 characters. Generate them with:
#
#   openssl rand -base64 32
#
# Use DIFFERENT values in every environment. A leaked development secret that
# also works in production means anyone can mint an admin token.
JWT_ACCESS_SECRET="change-me-run-openssl-rand-base64-32"
JWT_REFRESH_SECRET="change-me-a-different-openssl-rand-base64-32"

# The access token is stored in localStorage by the frontend, where any XSS can
# read it — keep the window short. The refresh token is stored hashed in the
# database and rotated on every use.
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# --- Supabase Storage ------------------------------------------------------
# Dashboard > Project Settings > API.
#
# SERVICE_ROLE_KEY bypasses row-level security entirely. It is server-side only
# and must never be sent to the browser or committed.
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# Product photos are world-readable. Verification documents (ID, อย.) are not:
# that bucket has no policies at all, and the only read path is a short-lived
# signed URL minted server-side for an admin.
SUPABASE_PUBLIC_BUCKET="product-photos"
SUPABASE_PRIVATE_BUCKET="verification-docs"
