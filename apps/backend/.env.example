# ---------------------------------------------------------------------------
# Backend environment
# Copy to `.env` (`make env` does this for you) and fill in real values.
# Never commit `.env` — it is gitignored.
# ---------------------------------------------------------------------------

# --- Supabase Postgres -----------------------------------------------------
# Supabase gives you TWO connection strings and they are NOT interchangeable.
# Find both under: Supabase dashboard > Project Settings > Database > Connection string
#
#   DATABASE_URL  Transaction pooler, port 6543. Used by the running app.
#                 Pooled connections are what a serverless/containerised app
#                 should hold.
#
#   DIRECT_URL    Direct / session connection, port 5432. Used by the Prisma
#                 CLI only (migrate, studio). Migrations create prepared
#                 statements and advisory locks, which the transaction pooler
#                 does not support — running them through 6543 will fail.
#
# Getting these two swapped is the single most common setup mistake here.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# --- Server ----------------------------------------------------------------
# Port the API listens on. Leave unset on Railway — it injects its own PORT.
PORT=3000

NODE_ENV=development

# Browser origin allowed to call this API.
# Local:   http://localhost:5173
# Railway: https://${{frontend.RAILWAY_PUBLIC_DOMAIN}}
CORS_ORIGIN="http://localhost:5173"
